<root BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="AppendGoalPoseToGoals">
            <output_port name="output_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Output goals after appending</output_port>
            <input_port name="input_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Input goals to append to</input_port>
            <input_port name="goal_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal pose to append</input_port>
        </Action>
        <Condition ID="AreErrorCodesPresent">
            <input_port name="error_codes_to_check" type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Error codes to check</input_port>
            <input_port name="error_code" type="unsigned short">The active error codes</input_port>
        </Condition>
        <Condition ID="ArePosesNear">
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="tolerance" type="double" default="0.500000">Tolerance</input_port>
            <input_port name="target_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
            <input_port name="ref_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
        </Condition>
        <Action ID="AssistedTeleop">
            <input_port name="time_allowance" type="double" default="10.000000">Allowed time for running assisted teleop</input_port>
            <input_port name="is_recovery" type="bool" default="false">If true the recovery count will be incremented</input_port>
            <output_port name="error_msg" type="std::string">The assisted teleop behavior server error msg</output_port>
            <output_port name="error_code_id" type="unsigned short">The assisted teleop behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="BackUp">
            <input_port name="backup_dist" type="double" default="0.150000">Distance to backup</input_port>
            <input_port name="backup_speed" type="double" default="0.025000">Speed at which to backup</input_port>
            <output_port name="error_msg" type="std::string">The back up behavior server error msg</output_port>
            <input_port name="time_allowance" type="double" default="10.000000">Allowed time for reversing</input_port>
            <input_port name="disable_collision_checks" type="bool" default="false">Disable collision checking</input_port>
            <output_port name="error_code_id" type="unsigned short">The back up behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelAssistedTeleop">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelBackUp">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelComputeAndTrackRoute">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelControl">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelDriveOnHeading">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelSpin">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="CancelWait">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ClearCostmapAroundRobot">
            <input_port name="reset_distance" type="double" default="1.000000">Distance from the robot under which obstacles are cleared</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearCostmapExceptRegion">
            <input_port name="reset_distance" type="double" default="1.000000">Distance from the robot above which obstacles are cleared</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ClearEntireCostmap">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="ComputeAndTrackRoute">
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose and using poses over IDs</input_port>
            <input_port name="use_poses" type="bool" default="false">Whether to use poses or IDs for start and goal</input_port>
            <output_port name="error_msg" type="std::string">The compute route error msg</output_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal pose of the path if using poses over IDs</input_port>
            <output_port name="execution_duration" type="builtin_interfaces::msg::Duration_&lt;std::allocator&lt;void&gt; &gt;">Time taken to compute and track route</output_port>
            <input_port name="goal_id" type="unsigned int">ID of the goal node</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute route error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="start_id" type="unsigned int">ID of the start node</input_port>
            <input_port name="use_start" type="bool" default="false">Whether to use the start pose or the robot's current pose</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ComputePathThroughPoses">
            <input_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Destinations to plan through</input_port>
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputePathThroughPoses node</output_port>
            <output_port name="error_msg" type="std::string">The compute path through poses error msg</output_port>
            <input_port name="planner_id" type="std::string" default="">Mapped name to the planner plugin type to use</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute path through poses error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ComputePathToPose">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Used as the planner start pose instead of the current robot pose, if use_start is not false (i.e. not provided or set to true)</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputePathToPose node</output_port>
            <output_port name="error_msg" type="std::string">The compute path to pose error msg</output_port>
            <input_port name="planner_id" type="std::string" default="">Mapped name to the planner plugin type to use</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute path to pose error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="use_start" type="bool">For using or not using (i.e. ignoring) the provided start pose</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ComputeRoute">
            <input_port name="start" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Start pose of the path if overriding current robot pose and using poses over IDs</input_port>
            <input_port name="use_poses" type="bool" default="false">Whether to use poses or IDs for start and goal</input_port>
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path created by ComputeRoute node</output_port>
            <output_port name="error_msg" type="std::string">The compute route error msg</output_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Goal pose of the path if using poses over IDs</input_port>
            <output_port name="route" type="nav2_msgs::msg::Route_&lt;std::allocator&lt;void&gt; &gt;">The route computed by ComputeRoute node</output_port>
            <output_port name="planning_time" type="builtin_interfaces::msg::Duration_&lt;std::allocator&lt;void&gt; &gt;">Time taken to compute route</output_port>
            <input_port name="goal_id" type="unsigned int">ID of the goal node</input_port>
            <output_port name="error_code_id" type="unsigned short">The compute route error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="start_id" type="unsigned int">ID of the start node</input_port>
            <input_port name="use_start" type="bool" default="false">Whether to use the start pose or the robot's current pose</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ConcatenatePaths">
            <output_port name="output_path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Paths concatenated</output_port>
            <input_port name="input_path2" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Input Path 2 to cancatenate</input_port>
            <input_port name="input_path1" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Input Path 1 to cancatenate</input_port>
        </Action>
        <Action ID="ControllerSelector">
            <output_port name="selected_controller" type="std::string">Selected controller by subscription</output_port>
            <input_port name="topic_name" type="std::string" default="controller_selector">the input topic name to select the controller</input_port>
            <input_port name="default_controller" type="std::string">the default controller to use if there is not any external topic message received.</input_port>
        </Action>
        <Decorator ID="DistanceController">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="distance" type="double" default="1.000000">Distance</input_port>
        </Decorator>
        <Condition ID="DistanceTraveled">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global frame</input_port>
            <input_port name="distance" type="double" default="1.000000">Distance</input_port>
        </Condition>
        <Action ID="DriveOnHeading">
            <input_port name="speed" type="double" default="0.025000">Speed at which to travel</input_port>
            <input_port name="time_allowance" type="double" default="10.000000">Allowed time for driving on heading</input_port>
            <input_port name="disable_collision_checks" type="bool" default="false">Disable collision checking</input_port>
            <output_port name="error_msg" type="std::string">The drive on heading behavior server error msg</output_port>
            <output_port name="error_code_id" type="unsigned short">The drive on heading behavior server error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="dist_to_travel" type="double" default="0.150000">Distance to travel</input_port>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="ExtractRouteNodesAsGoals">
            <output_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Output goals for navigation</output_port>
            <input_port name="route" type="nav2_msgs::msg::Route_&lt;std::allocator&lt;void&gt; &gt;">Route to extract nodes from</input_port>
        </Action>
        <Action ID="FollowPath">
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to follow</input_port>
            <output_port name="error_msg" type="std::string">The follow path error msg</output_port>
            <input_port name="controller_id" type="std::string"/>
            <input_port name="goal_checker_id" type="std::string"/>
            <input_port name="progress_checker_id" type="std::string"/>
            <output_port name="error_code_id" type="unsigned short">The follow path error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="GetCurrentPose">
            <output_port name="current_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Current pose output</output_port>
            <input_port name="robot_base_frame" type="std::string">robot base frame</input_port>
            <input_port name="global_frame" type="std::string">Global reference frame</input_port>
        </Action>
        <Action ID="GetNextFewGoals">
            <output_port name="output_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Output goals for navigation</output_port>
            <input_port name="num_goals" type="int">Number of goals to extract</input_port>
            <input_port name="input_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Input goals for navigation</input_port>
        </Action>
        <Action ID="GetPoseFromPath">
            <input_port name="index" type="int" default="0">Index of pose to extract from. -1 is end of list</input_port>
            <output_port name="pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Stamped Extracted Pose</output_port>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to extract pose from</input_port>
        </Action>
        <Condition ID="GlobalUpdatedGoal">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Vector of navigation goals</input_port>
        </Condition>
        <Action ID="GoalCheckerSelector">
            <output_port name="selected_goal_checker" type="std::string">Selected goal_checker by subscription</output_port>
            <input_port name="topic_name" type="std::string" default="goal_checker_selector">the input topic name to select the goal_checker</input_port>
            <input_port name="default_goal_checker" type="std::string">the default goal_checker to use if there is not any external topic message received.</input_port>
        </Action>
        <Condition ID="GoalReached">
            <input_port name="robot_base_frame" type="std::string">Robot base frame</input_port>
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination</input_port>
        </Condition>
        <Condition ID="GoalUpdated">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Vector of navigation goals</input_port>
        </Condition>
        <Decorator ID="GoalUpdatedController">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Navigation goal</input_port>
            <input_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Vector of navigation goals</input_port>
        </Decorator>
        <Decorator ID="GoalUpdater">
            <output_port name="output_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Received Goals by subscription</output_port>
            <output_port name="output_goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Received Goal by subscription</output_port>
            <input_port name="input_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Original Goals</input_port>
            <input_port name="input_goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Original Goal</input_port>
        </Decorator>
        <Condition ID="InitialPoseReceived">
            <input_port name="initial_pose_received" type="bool"/>
        </Condition>
        <Condition ID="IsBatteryCharging">
            <input_port name="battery_topic" type="std::string" default="/battery_status">Battery topic</input_port>
        </Condition>
        <Condition ID="IsBatteryLow">
            <input_port name="is_voltage" type="bool" default="false">If true voltage will be used to check for low battery</input_port>
            <input_port name="battery_topic" type="std::string" default="/battery_status">Battery topic</input_port>
            <input_port name="min_battery" type="double">Minimum battery percentage/voltage</input_port>
        </Condition>
        <Condition ID="IsPathValid">
            <input_port name="consider_unknown_as_obstacle" type="bool" default="false">Whether to consider unknown cost as obstacle</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="max_cost" type="unsigned int" default="253">Maximum cost of the path</input_port>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Path to Check</input_port>
        </Condition>
        <Condition ID="IsStopped">
            <input_port name="duration_stopped" type="std::chrono::milliseconds" default="json:{&quot;__type&quot;:&quot;std::chrono::milliseconds&quot;,&quot;ms&quot;:1000}">Duration (ms) the velocity must remain below the threshold</input_port>
            <input_port name="velocity_threshold" type="double" default="0.010000">Velocity threshold below which robot is considered stopped</input_port>
        </Condition>
        <Condition ID="IsStuck"/>
        <Action ID="NavigateThroughPoses">
            <input_port name="goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Destinations to plan through</input_port>
            <input_port name="behavior_tree" type="std::string">Behavior tree to run</input_port>
            <output_port name="error_msg" type="std::string">The navigate through poses error msg</output_port>
            <output_port name="error_code_id" type="unsigned short">The navigate through poses error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="NavigateToPose">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
            <input_port name="behavior_tree" type="std::string">Behavior tree to run</input_port>
            <output_port name="error_msg" type="std::string">Navigate to pose error msg</output_port>
            <output_port name="error_code_id" type="unsigned short">Navigate to pose error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="PathExpiringTimer">
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="seconds" type="double" default="1.000000">Seconds</input_port>
        </Condition>
        <Decorator ID="PathLongerOnApproach">
            <input_port name="prox_len" type="double" default="3.000000">Proximity length (m) for the path to be longer on approach</input_port>
            <input_port name="length_factor" type="double" default="2.000000">Length multiplication factor to check if the path is significantly longer</input_port>
            <input_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;">Planned Path</input_port>
        </Decorator>
        <Control ID="PipelineSequence"/>
        <Action ID="PlannerSelector">
            <output_port name="selected_planner" type="std::string">Selected planner by subscription</output_port>
            <input_port name="topic_name" type="std::string" default="planner_selector">the input topic name to select the planner</input_port>
            <input_port name="default_planner" type="std::string">the default planner to use if there is not any external topic message received.</input_port>
        </Action>
        <Action ID="ProgressCheckerSelector">
            <output_port name="selected_progress_checker" type="std::string">Selected progress_checker by subscription</output_port>
            <input_port name="topic_name" type="std::string" default="progress_checker_selector">the input topic name to select the progress_checker</input_port>
            <input_port name="default_progress_checker" type="std::string">the default progress_checker to use if there is not any external topic message received.</input_port>
        </Action>
        <Decorator ID="RateController">
            <input_port name="hz" type="double" default="10.000000">Rate</input_port>
        </Decorator>
        <Control ID="RecoveryNode">
            <input_port name="number_of_retries" type="int" default="1">Number of retries</input_port>
        </Control>
        <Action ID="ReinitializeGlobalLocalization">
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="RemoveGoalById">
            <output_port name="output_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Goals with the goal removed</output_port>
            <input_port name="goal_to_remove_id_" type="double" default="-1.000000">ID of the goal to remove from the list of goals</input_port>
            <input_port name="input_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Original goals to remove a goal from</input_port>
        </Action>
        <Action ID="RemoveInCollisionGoals">
            <input_port name="input_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Original goals to remove from</input_port>
            <input_port name="cost_threshold" type="double" default="254.000000">Cost threshold for considering a goal in collision</input_port>
            <input_port name="consider_unknown_as_obstacle" type="bool" default="false">Whether to consider unknown cost as obstacle</input_port>
            <output_port name="output_goals" type="nav_msgs::msg::Goals_&lt;std::allocator&lt;void&gt; &gt;">Goals with in-collision goals removed</output_port>
            <input_port name="input_waypoint_statuses" type="std::vector&lt;nav2_msgs::msg::WaypointStatus_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;nav2_msgs::msg::WaypointStatus_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Original waypoint_statuses to mark waypoint status from</input_port>
            <output_port name="output_waypoint_statuses" type="std::vector&lt;nav2_msgs::msg::WaypointStatus_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;nav2_msgs::msg::WaypointStatus_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;">Waypoint_statuses with in-collision waypoints marked</output_port>
            <input_port name="use_footprint" type="bool" default="true">Whether to use footprint cost</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="service_name" type="std::string">please_set_service_name_in_BT_Node</input_port>
        </Action>
        <Action ID="RemovePassedGoals">
